{
  "artiest_workspace": 2,
  "id": "minimal",
  "name": "Minimal",
  "description": "Three lists of names. No shapes, no positions, and it is still a whole workspace.",
  "author": "artiest examples",
  "revision": 1,
  "filter": {"groups": ["draw", "edit"], "hide": ["grain", "opacity", "flow"], "show": []},
  "defaults": {"brush": null, "shelf": [], "stabilisation": null},
  "surfaces": [
    {
      "anchor": "left",
      "tools": ["pen", "pencil", "marker", "eraser", "colour"]
    },
    {
      "anchor": "top",
      "tools": ["undo", "redo"]
    },
    {
      "anchor": "bottom",
      "tools": ["size", "smoothing", "eraser_size"]
    }
  ]
}
