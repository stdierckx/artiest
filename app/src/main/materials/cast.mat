// Marble, bronze and terracotta, made in the shader rather than fetched from
// pictures.
//
// Lr12. Half the scans in a free model library arrive with no material on them
// at all. glTF says a primitive with no material is plain white, and white is
// the one colour that cannot be drawn from: a white surface lit by a white key
// light has almost no shading left in it -- the lightest plane and the second
// lightest plane both sit at the top of the range with nowhere to separate. The
// artist is being asked to study form in the one value where form does not
// show.
//
// What a life room puts in front of a student instead is a cast, and a cast is
// in one of three things. This is those three, and they are one shader with one
// set of parameters rather than three materials, because they differ in their
// numbers and not in their arithmetic: a marble is pale stone with grey veins
// and dark flecks, a terracotta is the same arithmetic in orange with more
// mottling and hardly any veins, and a bronze is the same again in metal, with
// the veins turned into patina and told to run downhill.
//
// The marble is measured off a photograph of a fourteenth-century alabaster
// Virgin, chosen by the artist and read off the tablet rather than remembered:
// a lit plane in it is (214, 204, 190) and a shadowed one (126, 114, 98).
//
// ## Why it is computed and not a photograph of marble
//
// A texture would need two things this repo will not have. It would need the
// pictures themselves -- tiling marble, bronze and terracotta images, of a size
// worth shipping, under licences that survive being in an Apache-2.0 app -- and
// it would need UV coordinates on the model, which a scan that arrived with no
// material also usually has none of. Neither problem exists if the surface is a
// function of where the point is on the form: it needs no file, no licence and
// no UVs, it never repeats, and it costs a few dozen arithmetic instructions a
// pixel.
//
// ## What is in it, in the order it is visible from across a room
//
//  - the body: the colour of the material itself, with a little unevenness in
//    it, because nothing that was ever in the ground is flat;
//  - the veins: soft wandering bands a shade or two darker. A sine gives
//    parallel stripes and reads as fabric, so the sine's argument is displaced
//    by several radians of noise and the stripes wander and fork instead;
//  - the specks: a fine noise cut near its top so only the peaks survive, which
//    is what makes them flecks rather than a haze, and thinned again where a
//    slower field says the material is clean. Three per cent of the surface in
//    marble, a good deal more in terracotta, where they are pores;
//  - the sheen, broken where the specks are, which is most of what tells the
//    eye it is stone and not resin.
//
// ## Patina runs downhill
//
// The one thing bronze does that the other two do not: its veins are patina,
// and patina is weather. It gathers on the faces that look up and streaks off
// the ones that look down. `settling` says how much of that to apply, which is
// none for the two that are cut from a block and most of the way for the one
// that stood in a square for three hundred years.
//
// The specks fade out as the pixels get bigger than they are, for the reason
// the contour lines do: once one pixel spans several of them there is nothing
// left to draw but a shimmer that crawls when the model turns.
material {
    name : cast,
    shadingModel : lit,
    blending : opaque,
    vertexDomain : object,
    // Where the point is on the form. A varying, and in the one space that is
    // nailed to the model -- see the vertex block, where getting this wrong
    // made the surface slide about under the artist's finger.
    variables : [ formPosition ],
    parameters : [
        // The material, the colour of its veins, and the colour of its specks.
        { type : float3, name : pale },
        { type : float3, name : vein },
        { type : float3, name : grit },
        // One unit is the model's own half-size, so the same stone lands on a
        // bust exported in millimetres and one exported in metres.
        { type : float,  name : perUnit },
        { type : float,  name : roughness },
        // Metal or not. Nothing between 0 and 1 is a real material, but the
        // patina on a bronze is not metal, so this is scaled down where the
        // veins are and the in-between is a boundary rather than a substance.
        { type : float,  name : metallic },
        // How much of each of the three. See the top of this file.
        { type : float,  name : veining },
        { type : float,  name : speckling },
        { type : float,  name : mottling },
        // How far the veins prefer the faces that look up. Weather, in one
        // number: nothing for cut stone, most of the way for a bronze.
        { type : float,  name : settling }
    ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        // ## The `getUserWorldFromWorldMatrix` is the whole point of this line
        //
        // Filament renders with the camera at the origin: everything is moved
        // so that the numbers stay small and precise however far from the world
        // origin the scene is. That makes the shader's "world" space one that
        // *moves with the camera*, and a pattern computed in it is nailed to
        // the room rather than to the model -- so turning the model dragged the
        // stone across its surface, which is exactly what a real stone never
        // does and what the eye notices first.
        //
        // `getUserWorldFromWorldMatrix()` undoes that shift and gives the world
        // the scene was actually built in. The model does not move in it, so
        // neither does its grain.
        material.formPosition =
            getUserWorldFromWorldMatrix() * (getWorldFromModelMatrix() * getPosition());
    }
}

fragment {
    // ## Every `highp` below is load-bearing
    //
    // matc compiles the mobile fragment shader with `precision mediump float`,
    // and its optimiser demotes anything it is allowed to demote. Half
    // precision has an eleven-bit mantissa, and a hash works by throwing away
    // the top of a number and keeping the bottom -- so in mediump this one
    // stops being a hash. Measured, not feared: the same arithmetic in
    // float32 gives a mean of 0.50 and 6749 distinct values over the model,
    // and in float16 a mean of 0.09 and 67. On the tablet that came out as a
    // bust with no grain, no veins and no mottling, uniform to five values in
    // two hundred and fifty-five, which looks exactly like a shader that was
    // never applied. So `highp` is written on every line the numbers get
    // large on, and the generated GLSL is worth re-reading if this is ever
    // edited: `matc -p mobile -a opengl -t` prints it.

    // A number in 0..1 from a point, repeatable and with no pattern to it.
    // Hoskins' hash: three multiplies and a fract, and cheaper than the usual
    // fract(sin(dot(...))) by a transcendental.
    float speck(highp vec3 q) {
        highp vec3 p = fract(q * 0.1031);
        p += dot(p, p.zyx + 31.32);
        return fract((p.x + p.y) * p.z);
    }

    // Value noise: the eight corners of the cell, smoothly mixed.
    float lump(highp vec3 x) {
        highp vec3 i = floor(x);
        highp vec3 f = fract(x);
        f = f * f * (3.0 - 2.0 * f);
        float n000 = speck(i);
        float n100 = speck(i + vec3(1.0, 0.0, 0.0));
        float n010 = speck(i + vec3(0.0, 1.0, 0.0));
        float n110 = speck(i + vec3(1.0, 1.0, 0.0));
        float n001 = speck(i + vec3(0.0, 0.0, 1.0));
        float n101 = speck(i + vec3(1.0, 0.0, 1.0));
        float n011 = speck(i + vec3(0.0, 1.0, 1.0));
        float n111 = speck(i + vec3(1.0, 1.0, 1.0));
        return mix(mix(mix(n000, n100, f.x), mix(n010, n110, f.x), f.y),
                   mix(mix(n001, n101, f.x), mix(n011, n111, f.x), f.y), f.z);
    }

    // Two octaves and not five. Every octave is eight hashes a pixel, and the
    // third one here is already below the size of a pixel on a pane this
    // small: it costs a fifth of the shader to draw nothing but shimmer.
    // Measured while turning a model, which is the only moment this shader is
    // asked for sixty frames a second.
    float cloud(highp vec3 p) {
        // Scaled back up to 0..1, so the thresholds that read it are about the
        // middle of its range and not about two thirds of it.
        return (0.5 * lump(p) + 0.25 * lump(p * 2.07)) * 1.3333;
    }

    // One family of veins: a wide slow band, bent hard by the noise before it
    // is measured.
    //
    // The bending is the whole trick, and it is why this is not the sine it
    // looks like. A sine on its own gives parallel stripes at a fixed angle,
    // which reads as fabric. Displacing its argument by several radians of
    // noise turns the same stripes into something that wanders, forks and
    // occasionally doubles back, which is what a vein does. `edge` sets how
    // much of each period survives as a vein: high, so most of the stone is
    // clear and the veins are a minority of it.
    float nerve(highp float phase, float bend, float edge) {
        float band = sin(phase + bend);
        return smoothstep(edge, 1.0, 0.5 + 0.5 * band);
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        highp vec3 p = variable_formPosition.xyz * materialParams.perUnit;

        // Two noise fields at the scale of the whole form: one bends the veins,
        // the other decides where the specks gather.
        float drift = cloud(p * 1.6);
        float spread = cloud(p * 6.0);

        // Two families of veins crossing at a shallow angle, the second finer
        // and fainter, so they read as a network rather than as a comb.
        float wide = nerve((p.x * 1.2 + p.y * 2.1 - p.z * 0.8) * 3.4, (drift - 0.50) * 7.0, 0.80);
        float fine = nerve((p.x * 3.1 - p.y * 1.4 + p.z * 2.6) * 5.6, (spread - 0.50) * 8.0, 0.88);
        float veins = clamp(wide + 0.55 * fine, 0.0, 1.0);

        // Weather, and the two things it does.
        //
        // The first is that patina is not a vein. A vein is a seam in a block
        // and runs in a direction; corrosion is a patch and spreads from where
        // the water sat, so for a bronze the same bands are blended with the
        // broad blotches of `spread` and come out as crust rather than as
        // stripes. It is the field that was going to be computed anyway.
        //
        // The second is that it runs downhill. The geometric normal and not the
        // shading one, because what is being asked is which way the surface
        // faces, not what a normal map would like it to look like;
        // camera-relative rendering moves the world but does not turn it, so up
        // is still up in here.
        float crust = smoothstep(0.42, 0.74, spread);
        veins = mix(veins, max(veins * 0.55, crust), materialParams.settling);
        float up = getWorldGeometricNormalVector().y;
        float weather = mix(1.0, smoothstep(-0.55, 0.45, up), materialParams.settling);
        veins = clamp(veins * weather * materialParams.veining, 0.0, 1.0);

        // The specks: a fine noise cut near its top so only the peaks survive,
        // which is what makes them dots rather than a haze, and then thinned
        // where `spread` says the stone is clean.
        highp vec3 fines = p * 90.0;
        float across = max(fwidth(fines.x), fwidth(fines.y));
        float legible = 1.0 - smoothstep(0.30, 0.85, across);
        float specks = smoothstep(0.80, 0.93, lump(fines))
                     * mix(0.15, 1.0, smoothstep(0.34, 0.70, spread))
                     * legible * materialParams.speckling;

        // A hint of unevenness in the body -- a couple of per cent for marble,
        // which is nearly uniform and reads as stone because of what little of
        // it is not, and a good deal more for fired clay, which does not. It is
        // the speck field read again rather than a third noise, which is two
        // hashes instead of sixteen for a difference no eye could name.

        float body = (lump(fines * 0.09) - 0.46) * materialParams.mottling * legible;
        vec3 colour = materialParams.pale * (1.0 + body);
        colour = mix(colour, materialParams.vein, veins);
        colour = mix(colour, materialParams.grit, specks);

        material.baseColor = vec4(colour, 1.0);
        // Faintly glossy, and duller in the specks and along the veins -- a
        // sheen that breaks is what separates stone from resin, and patina from
        // the metal it grew on.
        material.roughness = clamp(
            materialParams.roughness + 0.34 * specks + 0.34 * veins - 0.35 * body,
            0.18, 1.0);
        // Patina is an oxide, and oxides are not metal.
        material.metallic = materialParams.metallic * (1.0 - 0.85 * veins);
    }
}
