{
  "artiest_workspace": 1,
  "catalogue": 1,
  "id": "sketcher",
  "name": "Sketcher",
  "description": "Pencil, paper, and nothing in the way.",
  "author": "artiest",
  "revision": 1,
  "filter": {"groups": ["edit", "draw"], "hide": [], "show": ["fit", "layers", "layers_panel"]},
