{
  "artiest_workspace": 2,
  "catalogue": 9,
  "id": "learner",
  "name": "Learner",
  "description": "A picture to draw from, and somewhere to keep what you work out.",
  "author": "artiest",
  "revision": 1,
  "filter": {"groups": ["edit", "draw", "learn"], "hide": [], "show": ["fit", "layers", "layers_panel"]},
